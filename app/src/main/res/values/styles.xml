<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Tema principale dell'app — ora scuro, coerente con la palette di MainActivity.kt -->
    <style name="Theme.TravelPinsTest"
        parent="Theme.AppCompat.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="colorPrimary">#6C5CE7</item>
        <item name="colorPrimaryDark">#5847C9</item>
        <item name="colorAccent">#6C5CE7</item>

        <item name="android:windowBackground">#12121A</item>
        <item name="android:colorBackground">#12121A</item>

        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9A9AB0</item>

        <item name="android:statusBarColor">#12121A</item>
        <item name="android:navigationBarColor">#12121A</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>

    <!-- Tema scuro per gli AlertDialog (categorie, picker, log, ecc.) -->
    <!-- Coerente con la palette di MainActivity.kt: COLOR_SURFACE / COLOR_ACCENT / COLOR_TEXT_* -->
    <style name="Theme.TravelPinsTest.DarkDialog"
        parent="Theme.AppCompat.Dialog.Alert">

        <item name="colorPrimary">#6C5CE7</item>
        <item name="colorAccent">#6C5CE7</item>
        <item name="colorPrimaryDark">#5847C9</item>

        <item name="android:windowBackground">@drawable/dialog_dark_background</item>

        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9A9AB0</item>
        <item name="android:textColor">#FFFFFF</item>

        <!-- Titolo del dialog -->
        <item name="android:windowTitleStyle">@style/TravelPinsDialogTitle</item>

        <!-- Pulsanti (ANNULLA / CREA / ELIMINA, ecc.) -->
        <item name="buttonBarPositiveButtonStyle">@style/TravelPinsDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/TravelPinsDialogButton.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/TravelPinsDialogButton.Neutral</item>

        <!-- Colore del testo delle voci in setItems(...) -->
        <item name="android:listChoiceIndicatorSingle">@null</item>

    </style>

    <style name="TravelPinsDialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TravelPinsDialogButton.Positive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#6C5CE7</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TravelPinsDialogButton.Neutral" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#9A9AB0</item>
    </style>

</resources>
